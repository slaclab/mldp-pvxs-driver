# Singularity / Apptainer definition file for the MLDP PVXS Driver build environment.
#
# Installs EPICS Base, PVXS, gRPC, protobuf, and all compile-time dependencies.
# No driver source is embedded — bind-mount the source tree at build time:
#
#   apptainer run --bind $(pwd):/workspace mldp-pvxs-driver-env.sif \
#     bash -c "cmake -S /workspace -B /workspace/build -G Ninja \
#              -DCMAKE_BUILD_TYPE=Release && cmake --build /workspace/build"
#
# Build arguments (passed via --build-arg to apptainer build, or set as env vars
# before calling build_singularity_image.sh):
#   EPICS_VERSION  (default: R7.0.8.1)
#   PVXS_VERSION   (default: 1.4.1)
#   COMPILER       gcc | llvm  (default: gcc)

Bootstrap: docker
From: rockylinux/rockylinux:9.3

%arguments
    EPICS_VERSION=R7.0.8.1
    PVXS_VERSION=1.4.1
    COMPILER=gcc

%environment
    export EPICS_BASE=/opt/local
    export PVXS_BASE=/opt/local
    export PATH=/opt/local/bin:$PATH
    export LD_LIBRARY_PATH=/opt/local/lib:$LD_LIBRARY_PATH
    if [ -f /etc/epics_host_arch ]; then
        export EPICS_HOST_ARCH=$(cat /etc/epics_host_arch)
        export PATH=/opt/local/bin/${EPICS_HOST_ARCH}:$PATH
        export LD_LIBRARY_PATH=/opt/local/lib/${EPICS_HOST_ARCH}:$LD_LIBRARY_PATH
    fi

%post
    set -euo pipefail

    EPICS_VERSION="{{ EPICS_VERSION }}"
    PVXS_VERSION="{{ PVXS_VERSION }}"
    COMPILER="{{ COMPILER }}"

    # ---- System packages --------------------------------------------------------
    dnf update -y
    dnf groupinstall -y "Development Tools"
    dnf install -y dnf-plugins-core epel-release
    dnf config-manager --set-enabled crb
    dnf install -y \
        cmake git tcl ninja-build \
        protobuf-compiler grpc-plugins grpc-devel \
        openssl-devel cyrus-sasl-devel libcurl-devel libicu-devel \
        gdb clang libevent-devel python3-devel sqlite-devel \
        ca-certificates perl perl-Pod-Html perl-podlators \
        jq file sudo \
        rsync iperf3
    dnf install -y go-toolset lcov valgrind clang-tools-extra lldb lld \
        || echo "Warning: optional packages unavailable; continuing"
    dnf clean all
    rm -rf /var/cache/dnf

    # ---- Compiler selection -----------------------------------------------------
    if [ "$COMPILER" = "llvm" ]; then
        CC_BIN="$(command -v clang  || true)"
        CXX_BIN="$(command -v clang++ || true)"
    else
        CC_BIN="$(command -v gcc || true)"
        CXX_BIN="$(command -v g++ || true)"
    fi
    if [ -z "$CC_BIN" ] || [ -z "$CXX_BIN" ]; then
        echo "Compiler binaries not found for COMPILER=$COMPILER" >&2; exit 127
    fi
    ln -sf "$CC_BIN"  /usr/bin/cc
    ln -sf "$CXX_BIN" /usr/bin/c++
    echo "Building with: $(cc --version | head -1)"

    # ---- EPICS Base -------------------------------------------------------------
    git clone --branch "${EPICS_VERSION}" --depth 1 --recursive \
        https://github.com/epics-base/epics-base.git /opt/epics
    cd /opt/epics

    if [ "$COMPILER" = "llvm" ]; then
        for arch in linux-x86_64 linux-aarch64; do
            printf 'GNU_DIR=\nCC = clang\nCCC = clang++\nCMPLR_CLASS = clang\n' \
                > configure/os/CONFIG_SITE.Common.${arch}
        done
        mkdir -p include/compiler/clang
    fi

    make -j4 INSTALL_LOCATION=/opt/local
    make install INSTALL_LOCATION=/opt/local

    mkdir -p /opt/local/include/compiler/gcc /opt/local/include/compiler/clang
    if [ -f /opt/local/include/compiler/gcc/compilerSpecific.h ] && \
       [ ! -e /opt/local/include/compiler/clang/compilerSpecific.h ]; then
        ln -s ../gcc/compilerSpecific.h /opt/local/include/compiler/clang/compilerSpecific.h
    fi
    if [ -f /opt/local/include/compiler/clang/compilerSpecific.h ] && \
       [ ! -e /opt/local/include/compiler/gcc/compilerSpecific.h ]; then
        ln -s ../clang/compilerSpecific.h /opt/local/include/compiler/gcc/compilerSpecific.h
    fi

    # ---- Detect and record EPICS host arch --------------------------------------
    EPICS_HOST_ARCH=$(/opt/epics/startup/EpicsHostArch 2>/dev/null || true)
    if [ -z "$EPICS_HOST_ARCH" ]; then
        case "$(uname -m)" in
            x86_64)  EPICS_HOST_ARCH=linux-x86_64  ;;
            aarch64) EPICS_HOST_ARCH=linux-aarch64 ;;
            *)       EPICS_HOST_ARCH="linux-$(uname -m)" ;;
        esac
    fi
    echo "$EPICS_HOST_ARCH" > /etc/epics_host_arch

    # Ensure epics bin/lib symlinks exist for tools that look in /opt/epics
    mkdir -p /opt/epics/bin /opt/epics/lib
    [ -e "/opt/epics/bin/${EPICS_HOST_ARCH}" ] || \
        ln -s "/opt/local/bin/${EPICS_HOST_ARCH}" "/opt/epics/bin/${EPICS_HOST_ARCH}"
    [ -e "/opt/epics/lib/${EPICS_HOST_ARCH}" ] || \
        ln -s "/opt/local/lib/${EPICS_HOST_ARCH}" "/opt/epics/lib/${EPICS_HOST_ARCH}"

    # ---- PVXS -------------------------------------------------------------------
    git clone --branch "${PVXS_VERSION}" --depth 1 \
        https://github.com/epics-base/pvxs.git /opt/pvxs
    cd /opt/pvxs
    echo "EPICS_BASE=/opt/local"           > configure/RELEASE.local
    echo "EPICS_HOST_ARCH=${EPICS_HOST_ARCH}" >> configure/RELEASE.local
    echo "INSTALL_LOCATION=/opt/local"     >> configure/RELEASE.local
    EPICS_HOST_ARCH=${EPICS_HOST_ARCH} make -j4
    EPICS_HOST_ARCH=${EPICS_HOST_ARCH} make install

    # Fallback copy if make install didn't drop files into /opt/local
    ls /opt/local/lib/${EPICS_HOST_ARCH}/libpvxs* >/dev/null 2>&1 || \
        cp -a /opt/pvxs/lib/${EPICS_HOST_ARCH}/. /opt/local/lib/${EPICS_HOST_ARCH}/
    ls /opt/local/include/pvxs/version.h >/dev/null 2>&1 || \
        cp -a /opt/pvxs/include/. /opt/local/include/

    echo "Build environment ready."
    echo "  EPICS_BASE=${EPICS_BASE:-/opt/local}"
    echo "  PVXS_BASE=/opt/local"
    echo "  EPICS_HOST_ARCH=${EPICS_HOST_ARCH}"

%runscript
    exec bash "$@"

%labels
    Maintainer  SLAC National Accelerator Laboratory
    Description MLDP PVXS Driver build environment (EPICS + PVXS + gRPC)
