+void Terminal::begin_frame( void ) {
+#ifndef _WIN32
+	if ( _frameDepth ++ == 0 ) {
+		_frame.assign( "\033[?2026h" );
+	}
+#endif
+}
+
+void Terminal::end_frame( void ) {
+#ifndef _WIN32
+	if ( ( _frameDepth > 0 ) && ( -- _frameDepth == 0 ) ) {
+		_frame.append( "\033[?2026l" );
+		char const* p( _frame.data() );
+		size_t left( _frame.size() );
+		while ( left > 0 ) {
+			ssize_t n( ::write( 1, p, left ) );
+			if ( n < 0 ) {
+				if ( errno == EINTR ) {
+					continue;
+				}
+				break;
+			}
+			p += n;
+			left -= static_cast<size_t>( n );
+		}
+		_frame.clear();
+	}
+#endif
+}
+
 Terminal::~Terminal( void ) {
