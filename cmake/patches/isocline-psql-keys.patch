+/// Key code (e.g. 3 for ctrl+C, 4 for ctrl+D, 17 for ctrl+Q) that ended the last
+/// readline call, and whether the edited input was empty at that point.
+int  ic_last_exit_key(void);
+bool ic_last_exit_input_empty(void);
+
+/// Called on Enter with the whole input; returning false inserts a newline
+/// instead of accepting, so a multi-line statement stays in one edit buffer.
+typedef bool (ic_input_complete_fun_t)(const char* input, void* arg);
+void ic_set_input_complete(ic_input_complete_fun_t* fun, void* arg);
+
 /// \}
 
 
